  "trials": [
    { "name": "ttt3r_smoke", "mode": "ttt3r" },
    {
      "name": "hmr_full_v1_smoke",
      "mode": "hmr_full",
      "memory": {
        "enable_v2_write_gate": false,
        "enable_v2_recover_gate": false,
        "enable_v2_hierarchy": false,
        "enable_v2_merge": false,
        "enable_v2_local_adapt": false
      }
    },
    { "name": "hmr_v2_full_smoke", "mode": "hmr_v2_full" }
  ]
}
